#package('studio/resource_policy/discovery')
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $route('/_studio/resource-policy-catalog', 'GET'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('head', 'sql/read.sql'))
#define($_ = $Tenant<string>(query/tenant).Required())
#define($_ = $NamespaceId<string>(query/namespaceId).Required())
#define($_ = $Heads<[]*PolicyHead>(output/view))
SELECT head.*, type(head, 'PolicyHead'), CAST(head.resource_kind AS string),
       CAST(head.resource_id AS string), CAST(head.resource_version AS string),
       CAST(head.revision AS int64), set_limit(head, 0)
FROM (${embed:sql/read.sql}) head
WHERE 1=1

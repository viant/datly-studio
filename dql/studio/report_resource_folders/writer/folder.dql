#package('studio/report_resource_folders/writer')

#import('github.com/viant/scy/auth/jwt')
#import('github.com/viant/xdatly/response')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/report-resource-folders', 'PATCH'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('resource_folder', 'sql/patch.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Folders<[]*ReportResourceFolder>(body/data))
#define($_ = $Status<response.Status>(output/status).Embed())
#define($_ = $Violations<?>(transient/status).Output())
#define($_ = $Data<[]*ReportResourceFolder>(body/).Output())
SELECT resource_folder.*, type(resource_folder, 'ReportResourceFolder'),
       lifecycle_type(resource_folder, 'FolderRules'),
       tag(resource_folder.report_id, 'sqlx:"report_id,primaryKey" validate:"required"'),
       tag(resource_folder.version_no, 'sqlx:"version_no,primaryKey"'),
       tag(resource_folder.folder_id, 'sqlx:"folder_id,primaryKey" validate:"required"'),
       tag(resource_folder.namespace, 'validate:"required"'), tag(resource_folder.root_path, 'validate:"required"'), tag(resource_folder.uri_prefix, 'validate:"required"'),
       CAST(resource_folder.should_delete AS bool), delete_marker(resource_folder.should_delete)
FROM (${embed:sql/patch.sql}) resource_folder
WHERE 1=1

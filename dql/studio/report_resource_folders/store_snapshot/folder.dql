#package('studio/report_resource_folders/store_snapshot')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/resource-snapshot/folders', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('folder', 'sql/read.sql'))

#define($_ = $ReportId<string>(query/reportId).Required().WithPredicate(0, 'equal', 'f', 'report_id'))
#define($_ = $VersionNo<int>(query/versionNo).Required().WithPredicate(0, 'equal', 'f', 'version_no'))
#define($_ = $Folders<[]*SnapshotFolder>(output/view))

SELECT folder.*, type(folder, 'SnapshotFolder'),
       CAST(folder.report_id AS string), CAST(folder.version_no AS int),
       CAST(folder.folder_id AS string), CAST(folder.namespace AS string),
       CAST(folder.root_path AS string), CAST(folder.uri_prefix AS string),
       CAST(folder.ordinal AS int), set_limit(folder, 0)
FROM (${embed:sql/read.sql}) folder
WHERE 1=1
ORDER BY folder.ordinal, folder.folder_id

#package('studio/report_resource_folders/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports/{reportId}/versions/{versionNo}/resources/folders', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_resource_folders.read', 'Read report resource folders'))
#setting($_ = $sql_dest('resource_folder', 'sql/read.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(path/reportId).Required().WithPredicate(2, 'equal', 'f', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.ReportResourceFolderRead'))
#define($_ = $VersionNo<int>(path/versionNo).Required().WithPredicate(2, 'equal', 'f', 'version_no'))
#define($_ = $Namespace<string>(query/namespace).Optional().WithPredicate(1, 'equal', 'f', 'namespace'))
#define($_ = $Folders<[]*ReportResourceFolder>(output/view))
SELECT resource_folder.*, type(resource_folder, 'ReportResourceFolder') FROM (${embed:sql/read.sql}) resource_folder
WHERE 1=1

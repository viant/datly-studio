#package('studio/resource_namespaces/store_usage')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/resource-namespace-store/usage', 'GET'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('resource_usage', 'sql/read.sql'))

#define($_ = $NamespaceId<string>(query/namespaceId).Required())
#define($_ = $Namespace<string>(query/namespace).Required().WithPredicate(0, 'equal', 'u', 'namespace'))
#define($_ = $ExcludeReportId<string>(query/excludeReportId).Required().WithPredicate(0, 'not_equal', 'u', 'report_id'))
#define($_ = $Usages<[]*NamespaceUsage>(output/view))

SELECT resource_usage.*, type(resource_usage, 'NamespaceUsage'),
       CAST(resource_usage.report_id AS string),
       CAST(resource_usage.namespace AS string),
       set_limit(resource_usage, 2)
FROM (${embed:sql/read.sql}) resource_usage
WHERE 1=1

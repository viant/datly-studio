#package('studio/namespaces/store_read')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/namespace-store/read', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('namespace', 'sql/read.sql'))

#define($_ = $Name<string>(query/name).Optional())
#define($_ = $OwnerId<string>(query/ownerId).Optional())
#define($_ = $Query<string>(query/q).Optional())
#define($_ = $Status<string>(query/status).Optional())
#define($_ = $Subject<string>(query/subject).Optional())
#define($_ = $Scoped<bool>(query/scoped).Required())
#define($_ = $PageLimit<int>(query/pageLimit).Required())
#define($_ = $PageOffset<int>(query/pageOffset).Required())
#define($_ = $Namespaces<[]*StoredNamespace>(output/view))

SELECT namespace.*, type(namespace, 'StoredNamespace'),
       CAST(namespace.owner_id AS string), CAST(namespace.name AS string),
       CAST(namespace.title AS string), CAST(namespace.description AS *string),
       CAST(namespace.status AS string), CAST(namespace.etag AS int64),
       CAST(namespace.created_at AS time.Time), CAST(namespace.updated_at AS time.Time),
       set_limit(namespace, 0)
FROM (${embed:sql/read.sql}) namespace
WHERE 1=1

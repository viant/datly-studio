#package('studio/namespaces/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('NamespaceQueryInput'))
#setting($_ = $output_type('NamespaceQueryOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/namespaces.list', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.namespaces.list', 'List authorized Datly Studio namespaces'))
#setting($_ = $sql_dest('namespace', 'sql/namespace.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.NamespaceRead'))
#define($_ = $Query<string>(body/query).WithTag('json:"query"').Optional().WithPredicate(0, 'contains', 'n', 'name').WithPredicate(0, 'contains', 'n', 'title').WithPredicate(0, 'contains', 'n', 'description'))
#define($_ = $Status<string>(body/status).WithTag('json:"status"').Optional().WithPredicate(1, 'equal', 'n', 'status'))
#define($_ = $Limit<int>(body/limit).WithTag('json:"limit"').Optional().QuerySelector('namespace'))
#define($_ = $Offset<int>(body/offset).WithTag('json:"offset"').Optional().QuerySelector('namespace'))
#define($_ = $Items<[]*NamespaceRecord>(output/view))
#define($_ = $PageLimit<int>(output/body).WithTag('json:"limit"'))
#define($_ = $PageOffset<int>(output/body).WithTag('json:"offset"'))

SELECT namespaces.*, type(namespaces, 'NamespaceRecord'),
       CAST(namespaces.owner_id AS string),
       CAST(namespaces.name AS string),
       CAST(namespaces.title AS string),
       CAST(namespaces.description AS *string),
       CAST(namespaces.status AS string),
       CAST(namespaces.etag AS int64),
       CAST(namespaces.created_at AS time.Time), CAST(namespaces.updated_at AS time.Time),
       tag(namespaces.description, 'json:"description,omitempty"'),
       set_limit(namespaces, 500),
       selector_limit(namespaces, true),
       selector_offset(namespaces, true)
FROM (
    ${embed:sql/read.sql}
) namespaces
WHERE 1=1
${predicate.Builder().CombineAnd($predicate.FilterGroup(3, "AND")).Build("AND")}
ORDER BY namespaces.updated_at DESC, namespaces.name ASC

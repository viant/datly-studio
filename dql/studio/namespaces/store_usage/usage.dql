#package('studio/namespaces/store_usage')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/namespace-store/usage', 'GET'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('usage_count', 'sql/read.sql'))

#define($_ = $OwnerId<string>(query/ownerId).Required())
#define($_ = $Name<string>(query/name).Required())
#define($_ = $Usages<[]*NamespaceUsage>(output/view))

SELECT usage_count.*, type(usage_count, 'NamespaceUsage'),
       CAST(usage_count.used AS int64), set_limit(usage_count, 1)
FROM (${embed:sql/read.sql}) usage_count
WHERE 1=1

#package('studio/namespaces/get')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('NamespaceGetInput'))
#setting($_ = $output_type('NamespaceGetOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/namespaces.get', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.namespaces.get', 'Read one authorized Datly Studio namespace'))
#setting($_ = $sql_dest('namespaces', 'sql/read.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.NamespaceRead'))
#define($_ = $Name<string>(body/name).WithTag('json:"name"').Required().WithPredicate(2, 'equal', 'n', 'name'))
#define($_ = $Item<*NamespaceRecord>(output/view).WithTag('json:"-"'))
#define($_ = $CanManage<bool>(output/body).WithTag('json:"canManage"'))
#define($_ = $NamespaceID<string>(output/body).WithTag('json:"namespaceId"'))
#define($_ = $Visibility<string>(output/body).WithTag('json:"visibility"'))
#define($_ = $AllowedRoles<[]string>(output/body).WithTag('json:"allowedRoles"'))
#define($_ = $MCPEnabled<bool>(output/body).WithTag('json:"mcpEnabled"'))
#define($_ = $MCPPort<*int>(output/body).WithTag('json:"mcpPort,omitempty"'))
#define($_ = $ManagerRoles<[]string>(output/body).WithTag('json:"managerRoles"'))
#define($_ = $OwnerId<string>(output/body).WithTag('json:"ownerId"'))
#define($_ = $ResponseName<string>(output/body).WithTag('json:"name"'))
#define($_ = $Title<string>(output/body).WithTag('json:"title"'))
#define($_ = $Description<string>(output/body).WithTag('json:"description,omitempty"'))
#define($_ = $Status<string>(output/body).WithTag('json:"status"'))
#define($_ = $Etag<int64>(output/body).WithTag('json:"etag"'))
#define($_ = $CreatedAt<time.Time>(output/body).WithTag('json:"createdAt"'))
#define($_ = $UpdatedAt<time.Time>(output/body).WithTag('json:"updatedAt"'))

SELECT namespaces.*, type(namespaces, 'NamespaceRecord'),
       CAST(namespaces.namespace_id AS string), CAST(namespaces.visibility AS string),
       CAST(namespaces.allowed_roles_json AS *string), CAST(namespaces.mcp_enabled AS bool), CAST(namespaces.mcp_port AS *int),
       tag(namespaces.allowed_roles_json, 'sqlx:"allowed_roles_json" json:"-"'),
       tag(namespaces.namespace_id, 'json:"namespaceId"'), tag(namespaces.mcp_enabled, 'json:"mcpEnabled"'), tag(namespaces.mcp_port, 'json:"mcpPort,omitempty"'),
       CAST(namespaces.owner_id AS string), CAST(namespaces.name AS string),
       CAST(namespaces.title AS string), CAST(namespaces.description AS *string),
       CAST(namespaces.status AS string), CAST(namespaces.etag AS int64),
       CAST(namespaces.created_at AS time.Time), CAST(namespaces.updated_at AS time.Time),
       set_limit(namespaces, 1)
FROM (${embed:sql/read.sql}) namespaces
WHERE 1=1
${predicate.Builder().CombineAnd($predicate.FilterGroup(3, "AND")).Build("AND")}

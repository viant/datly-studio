#package('studio/report_cube_configs/reader')

#import('github.com/viant/scy/auth/jwt')
#import('encoding/json')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports/{reportId}/versions/{versionNo}/cube', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_cube_configs.read', 'Read report cube configuration'))
#setting($_ = $sql_dest('cube_config', 'sql/read.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(path/reportId).Required().WithPredicate(2, 'equal', 'c', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.ReportCubeRead'))
#define($_ = $VersionNo<int>(path/versionNo).Required().WithPredicate(2, 'equal', 'c', 'version_no'))
#define($_ = $Configs<[]*ReportCubeConfig>(output/view))

SELECT cube_config.*, type(cube_config, 'ReportCubeConfig'),
	   CAST(cube_config.dimensions_json AS json.RawMessage),
	   CAST(cube_config.measures_json AS json.RawMessage),
	   CAST(cube_config.filters_json AS json.RawMessage),
	   CAST(cube_config.order_by_json AS json.RawMessage),
	   CAST(cube_config.input_layout_json AS json.RawMessage),
	   tag(cube_config.dimensions_json, 'sqlx:"dimensions_json,enc=JSON"'),
	   tag(cube_config.measures_json, 'sqlx:"measures_json,enc=JSON"'),
	   tag(cube_config.filters_json, 'sqlx:"filters_json,enc=JSON"'),
	   tag(cube_config.order_by_json, 'sqlx:"order_by_json,enc=JSON"'),
	   tag(cube_config.input_layout_json, 'sqlx:"input_layout_json,enc=JSON"')
FROM (
    ${embed:sql/read.sql}
) cube_config
WHERE 1=1

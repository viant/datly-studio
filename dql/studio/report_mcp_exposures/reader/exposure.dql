#package('studio/report_mcp_exposures/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports/{reportId}/versions/{versionNo}/mcp', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_mcp_exposures.read', 'Read report MCP exposures'))
#setting($_ = $sql_dest('mcp_exposure', 'sql/read.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(path/reportId).Required().WithPredicate(2, 'equal', 'e', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.ReportMCPRead'))
#define($_ = $VersionNo<int>(path/versionNo).Required().WithPredicate(2, 'equal', 'e', 'version_no'))
#define($_ = $Kind<string>(query/kind).Optional().WithPredicate(1, 'equal', 'e', 'kind'))
#define($_ = $RouteId<string>(query/routeId).Optional().WithPredicate(1, 'equal', 'e', 'route_id'))
#define($_ = $Enabled<bool>(query/enabled).Optional().WithPredicate(1, 'equal', 'e', 'enabled'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('exposure'))
#define($_ = $OrderBy<string>(query/orderBy).Optional().QuerySelector('exposure'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('exposure'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('exposure'))
#define($_ = $Exposures<[]*ReportMCPExposure>(output/view))

SELECT mcp_exposure.*, type(mcp_exposure, 'ReportMCPExposure'),
       set_limit(mcp_exposure, 100),
       selector_fields(mcp_exposure, true),
       selector_limit(mcp_exposure, true),
       selector_offset(mcp_exposure, true),
       allowed_order_by_columns(mcp_exposure, 'route_id,route_method,route_path,kind,name,enabled,ordinal')
FROM (
    ${embed:sql/read.sql}
) mcp_exposure
WHERE 1=1

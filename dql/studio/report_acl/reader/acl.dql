#package('studio/report_acl/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/acl.list', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.acl.list', 'List report ACL entries authorized for the current principal'))
#setting($_ = $sql_dest('component_acl', 'sql/read.sql'))
#define($_ = $NamespaceId<*string>(header/X-Studio-Namespace).Optional().WithTag('json:"namespaceId,omitempty"'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(body/reportId).WithTag('json:"reportId"').Required().WithPredicate(2, 'equal', 'a', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.ACLRead'))
#define($_ = $SubjectType<string>(query/subjectType).WithTag('json:"subjectType"').Optional().WithPredicate(1, 'equal', 'a', 'subject_type'))
#define($_ = $SubjectId<string>(query/subjectId).WithTag('json:"subjectId"').Optional().WithPredicate(1, 'equal', 'a', 'subject_id'))
#define($_ = $Items<[]*ReportACL>(output/view))
SELECT component_acl.*, type(component_acl, 'ReportACL'),
       CAST(component_acl.report_id AS *string), CAST(component_acl.subject_type AS *string),
       CAST(component_acl.subject_id AS *string), CAST(component_acl.etag AS *int),
       CAST(component_acl.can_view AS bool), CAST(component_acl.can_run AS bool),
       CAST(component_acl.can_edit AS bool), CAST(component_acl.can_publish AS bool),
       CAST(component_acl.can_use_dql AS bool)
FROM (${embed:sql/read.sql}) component_acl
WHERE 1=1

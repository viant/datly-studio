#package('studio/report_acl/writer')

#import('github.com/viant/scy/auth/jwt')
#import('github.com/viant/xdatly/response')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/report-acl', 'PATCH'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('component_acl', 'sql/patch.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Access<[]*ReportACL>(body/data))
#define($_ = $Status<response.Status>(output/status).Embed())
#define($_ = $Violations<?>(transient/status).Output())
#define($_ = $Data<[]*ReportACL>(body/).Output())
SELECT component_acl.*, type(component_acl, 'ReportACL'),
       lifecycle_type(component_acl, 'ACLRules'),
       tag(component_acl.report_id, 'sqlx:"report_id,primaryKey" validate:"required"'),
       tag(component_acl.subject_type, 'sqlx:"subject_type,primaryKey" validate:"required"'),
       tag(component_acl.subject_id, 'sqlx:"subject_id,primaryKey" validate:"required"'),
       CAST(component_acl.should_delete AS bool), delete_marker(component_acl.should_delete),
	   concurrency_token(component_acl.etag)
FROM (${embed:sql/patch.sql}) component_acl
WHERE 1=1

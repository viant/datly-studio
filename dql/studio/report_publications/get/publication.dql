#package('studio/report_publications/get')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('PublicationGetInput'))
#setting($_ = $output_type('PublicationGetOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/publications.get', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.publications.get', 'Read one authorized Datly Studio publication'))
#setting($_ = $sql_dest('publication', 'sql/publication.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.PublicationRead'))
#define($_ = $ReportId<string>(body/reportId).WithTag('json:"reportId"').Required().WithPredicate(2, 'equal', 'p', 'report_id'))
#define($_ = $Item<*Publication>(output/view).WithTag('json:"-"'))
#define($_ = $ResponseReportId<string>(output/body).WithTag('json:"reportId"'))
#define($_ = $ActiveVersionNo<int>(output/body).WithTag('json:"activeVersionNo"'))
#define($_ = $DesiredVersionNo<*int>(output/body).WithTag('json:"desiredVersionNo,omitempty"'))
#define($_ = $DesiredGeneration<int64>(output/body).WithTag('json:"desiredGeneration"'))
#define($_ = $ActiveGeneration<*int64>(output/body).WithTag('json:"activeGeneration,omitempty"'))
#define($_ = $Status<string>(output/body).WithTag('json:"status"'))
#define($_ = $RuntimeRevision<string>(output/body).WithTag('json:"runtimeRevision,omitempty"'))
#define($_ = $SpecHash<string>(output/body).WithTag('json:"specHash,omitempty"'))
#define($_ = $PublishedAt<*time.Time>(output/body).WithTag('json:"publishedAt,omitempty"'))

SELECT publication.*, type(publication, 'Publication'),
       CAST(publication.report_id AS string), CAST(publication.active_version_no AS int),
       CAST(publication.desired_version_no AS *int), CAST(publication.desired_generation AS int64),
       CAST(publication.active_generation AS *int64), CAST(publication.publication_status AS string),
       CAST(publication.runtime_revision AS *string), CAST(publication.spec_hash AS *string),
       CAST(publication.published_at AS *time.Time),
       set_limit(publication, 1)
FROM (${embed:sql/publication.sql}) publication
WHERE 1=1

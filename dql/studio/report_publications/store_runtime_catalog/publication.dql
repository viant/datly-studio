#package('studio/report_publications/store_runtime_catalog')

#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/publication-store/runtime-catalog', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('publication', 'sql/read.sql'))

#define($_ = $Status<string>(query/status).Required().WithPredicate(1, 'equal', 'c', 'publication_status'))
#define($_ = $Live<bool>(query/live).Required().WithPredicate(1, 'equal', 'c', 'report_live'))
#define($_ = $Publications<[]*PublishedComponent>(output/view))

SELECT publication.*, type(publication, 'PublishedComponent'),
       CAST(publication.report_id AS string),
       CAST(publication.report_namespace AS string),
       CAST(publication.report_slug AS string),
       CAST(publication.report_title AS string),
       CAST(publication.report_description AS *string),
       CAST(publication.report_owner_id AS string),
       CAST(publication.report_status AS string),
       CAST(publication.report_connector AS string),
       CAST(publication.report_component_scope AS string),
       CAST(publication.report_component_name AS string),
       CAST(publication.report_draft_version AS *int),
       CAST(publication.report_etag AS int64),
       CAST(publication.report_created_at AS time.Time),
       CAST(publication.report_updated_at AS time.Time),
       CAST(publication.publication_active_version_no AS int),
       CAST(publication.publication_desired_generation AS int64),
       CAST(publication.publication_active_generation AS *int64),
       CAST(publication.publication_status AS string),
       CAST(publication.publication_runtime_revision AS *string),
       CAST(publication.publication_published_at AS *time.Time),
       CAST(publication.version_state AS string),
       CAST(publication.version_authoring_mode AS string),
       CAST(publication.version_authored_sql AS *string),
       CAST(publication.version_authored_dql AS *string),
       CAST(publication.version_component_spec_json AS json.RawMessage),
       CAST(publication.version_spec_format_version AS string),
       CAST(publication.version_spec_hash AS string),
       CAST(publication.version_generated_dql AS *string),
       CAST(publication.version_dql_export_limits_json AS json.RawMessage),
       CAST(publication.version_type_manifest_json AS json.RawMessage),
       CAST(publication.version_resource_manifest_json AS json.RawMessage),
       CAST(publication.version_component_descriptor_json AS json.RawMessage),
       CAST(publication.version_compile_status AS string),
       CAST(publication.version_compile_diagnostics_json AS json.RawMessage),
       CAST(publication.version_datly_version AS string),
       CAST(publication.version_compiler_version AS string),
       CAST(publication.version_source_revision AS int64),
       CAST(publication.version_notes AS *string),
       CAST(publication.version_created_by AS string),
       CAST(publication.version_created_at AS time.Time),
       CAST(publication.version_validated_at AS *time.Time),
       CAST(publication.version_published_at AS *time.Time),
       CAST(publication.report_live AS bool),
       set_limit(publication, 0)
FROM (${embed:sql/read.sql}) publication
WHERE 1=1
ORDER BY publication.publication_published_at DESC, publication.report_id ASC

#package('studio/report_publications/reader')

#import('github.com/viant/scy/auth/jwt')
#import('encoding/json')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports/{reportId}/publication', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_publications.read', 'Read report publication state'))
#setting($_ = $sql_dest('publication', 'sql/read.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(path/reportId).Required().WithPredicate(2, 'equal', 'p', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.PublicationRead'))
#define($_ = $Publications<[]*ReportPublication>(output/view))
SELECT publication.*, type(publication, 'ReportPublication'),
	   CAST(publication.failure_json AS json.RawMessage),
	   tag(publication.failure_json, 'sqlx:"failure_json,enc=JSON"')
FROM (${embed:sql/read.sql}) publication
WHERE 1=1

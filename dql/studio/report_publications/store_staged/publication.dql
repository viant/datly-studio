#package('studio/report_publications/store_staged')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/publication-store/staged', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('publication', 'sql/read.sql'))

#define($_ = $DesiredGeneration<int64>(query/desiredGeneration).Required().WithPredicate(1, 'equal', 'p', 'desired_generation'))
#define($_ = $Publications<[]*StagedPublication>(output/view))

SELECT publication.*, type(publication, 'StagedPublication'),
       CAST(publication.report_id AS string),
       CAST(publication.desired_generation AS int64),
       CAST(publication.publication_status AS string),
       set_limit(publication, 0)
FROM (${embed:sql/read.sql}) publication
WHERE 1=1

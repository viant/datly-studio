#package('studio/report_publications/store_activate')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/publication-store/activate', 'PATCH'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('publication', 'sql/read.sql'))

#define($_ = $VersionNo<int>(query/versionNo).Required())
#define($_ = $Generation<int64>(query/generation).Required())
#define($_ = $Publications<[]*StoredPublication>(body/data))

SELECT publication.*, type(publication, 'StoredPublication'),
       CAST(publication.report_id AS string),
       CAST(publication.active_version_no AS *int),
       CAST(publication.desired_version_no AS *int),
       CAST(publication.desired_generation AS *int64),
       CAST(publication.active_generation AS *int64),
       CAST(publication.publication_status AS string),
       CAST(publication.activated_at AS *time.Time),
       CAST(publication.failure_json AS *string),
       tag(publication.report_id, 'sqlx:"report_id,primaryKey"'),
       tag(publication.failure_json, 'sqlx:"failure_json,enc=RAW"'),
       lifecycle_type(publication, 'PublicationActivationRules'),
       concurrency_token(publication.desired_generation)
FROM (${embed:sql/read.sql}) publication

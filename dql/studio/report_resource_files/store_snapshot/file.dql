#package('studio/report_resource_files/store_snapshot')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/resource-snapshot/files', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('file', 'sql/read.sql'))

#define($_ = $ReportId<string>(query/reportId).Required().WithPredicate(0, 'equal', 'f', 'report_id'))
#define($_ = $VersionNo<int>(query/versionNo).Required().WithPredicate(0, 'equal', 'f', 'version_no'))
#define($_ = $Files<[]*SnapshotFile>(output/view))

SELECT file.*, type(file, 'SnapshotFile'),
       CAST(file.report_id AS string), CAST(file.version_no AS int),
       CAST(file.resource_id AS string), CAST(file.namespace AS string),
       CAST(file.resource_path AS string), CAST(file.media_type AS *string),
       CAST(file.content AS []byte), CAST(file.content_size AS int64),
       CAST(file.content_sha256 AS string), CAST(file.is_binary AS bool),
       set_limit(file, 0)
FROM (${embed:sql/read.sql}) file
WHERE 1=1
ORDER BY file.namespace, file.resource_path

#package('studio/report_resource_files/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports/{reportId}/versions/{versionNo}/resources/files', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_resource_files.read', 'Read report resource files'))
#setting($_ = $sql_dest('resource_file', 'sql/read.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(path/reportId).Required().WithPredicate(2, 'equal', 'f', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.ReportResourceFileRead'))
#define($_ = $VersionNo<int>(path/versionNo).Required().WithPredicate(2, 'equal', 'f', 'version_no'))
#define($_ = $Namespace<string>(query/namespace).Optional().WithPredicate(1, 'equal', 'f', 'namespace'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('file'))
#define($_ = $OrderBy<string>(query/orderBy).Optional().QuerySelector('file'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('file'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('file'))
#define($_ = $Files<[]*ReportResourceFile>(output/view))
SELECT resource_file.*, type(resource_file, 'ReportResourceFile'), set_limit(resource_file, 100), selector_fields(resource_file, true), selector_limit(resource_file, true), selector_offset(resource_file, true), allowed_order_by_columns(resource_file, 'namespace,resource_path,content_size,created_at')
FROM (${embed:sql/read.sql}) resource_file
WHERE 1=1

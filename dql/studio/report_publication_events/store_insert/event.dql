#package('studio/report_publication_events/store_insert')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/publication-event-store/insert', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('event', 'sql/read.sql'))

#define($_ = $Events<[]*StoredEvent>(body/data))

SELECT event.*, type(event, 'StoredEvent'),
       CAST(event.event_id AS string), CAST(event.report_id AS string),
       CAST(event.owner_id AS string), CAST(event.operation AS string),
       CAST(event.version_no AS *int), CAST(event.generation_no AS *int64),
       CAST(event.status AS string), CAST(event.requested_by AS string),
       CAST(event.reason AS *string), CAST(event.failure_code AS *string),
       CAST(event.failure_message AS *string), CAST(event.occurred_at AS time.Time),
       tag(event.event_id, 'sqlx:"event_id,primaryKey"'),
       lifecycle_type(event, 'PublicationEventRules')
FROM (${embed:sql/read.sql}) event
WHERE 1=1

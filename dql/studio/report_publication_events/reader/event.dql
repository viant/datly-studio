#package('studio/report_publication_events/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/publication-events', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_publication_events.read', 'Read owner-scoped publication lifecycle evidence'))
#setting($_ = $sql_dest('event', 'sql/read.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportID<string>(query/reportId).Required().WithPredicate(1, 'equal', 'event', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.PublicationEventRead'))
#define($_ = $Operation<string>(query/operation).Optional().WithPredicate(1, 'equal', 'event', 'operation'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(1, 'equal', 'event', 'status'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('event'))
#define($_ = $OrderBy<string>(query/orderBy).Optional().QuerySelector('event'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('event'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('event'))
#define($_ = $Events<[]*PublicationEvent>(output/view))
SELECT event.*, type(event, 'PublicationEvent'),
       set_limit(event, 100), selector_fields(event, true), selector_limit(event, true), selector_offset(event, true),
       allowed_order_by_columns(event, 'occurred_at,operation,status,version_no,generation_no,requested_by')
FROM (${embed:sql/read.sql}) event
WHERE 1=1

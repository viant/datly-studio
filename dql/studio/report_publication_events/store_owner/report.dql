#package('studio/report_publication_events/store_owner')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/publication-event-store/owner', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('report', 'sql/read.sql'))

#define($_ = $ReportId<string>(query/reportId).Required())
#define($_ = $Reports<[]*StoredReport>(output/view))

SELECT report.*, type(report, 'StoredReport'),
       CAST(report.id AS string), CAST(report.owner_id AS string),
       set_limit(report, 1)
FROM (${embed:sql/read.sql}) report
WHERE 1=1

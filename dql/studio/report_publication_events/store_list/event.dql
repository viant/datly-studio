#package('studio/report_publication_events/store_list')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/publication-event-store/list', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('event', 'sql/read.sql'))

#define($_ = $ReportId<string>(query/reportId).Required())
#define($_ = $Operation<string>(query/operation).Optional())
#define($_ = $Status<string>(query/status).Optional())
#define($_ = $PageLimit<int>(query/pageLimit).Required())
#define($_ = $PageOffset<int>(query/pageOffset).Required())
#define($_ = $Events<[]*StoredEvent>(output/view))

SELECT event.*, type(event, 'StoredEvent'),
       CAST(event.event_id AS string), CAST(event.report_id AS string),
       CAST(event.owner_id AS string), CAST(event.operation AS string),
       CAST(event.version_no AS *int), CAST(event.generation_no AS *int64),
       CAST(event.status AS string), CAST(event.requested_by AS string),
       CAST(event.reason AS *string), CAST(event.failure_code AS *string),
       CAST(event.failure_message AS *string), CAST(event.occurred_at AS time.Time),
       set_limit(event, 0)
FROM (${embed:sql/read.sql}) event
WHERE 1=1
ORDER BY event.occurred_at DESC, event.event_id DESC

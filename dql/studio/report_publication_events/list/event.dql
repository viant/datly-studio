#package('studio/report_publication_events/list')

#import('github.com/viant/scy/auth/jwt')
#import('listoptions','github.com/viant/datly-studio/studio/report_publication_events/listoptions')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('PublicationEventsListInput'))
#setting($_ = $output_type('PublicationEventsListOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/publications.events.list', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.publications.events.list', 'List current-owner publication lifecycle events'))
#setting($_ = $sql_dest('event', 'sql/event.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.PublicationEventRead'))
#define($_ = $ReportId<string>(body/reportId).WithTag('json:"reportId"').Required())
#define($_ = $Input<listoptions.Options>(body/input).WithTag('json:"input"').Optional())
#define($_ = $Items<[]*PublicationEvent>(output/view))
#define($_ = $PageLimit<int>(output/body).WithTag('json:"limit"'))
#define($_ = $PageOffset<int>(output/body).WithTag('json:"offset"'))

SELECT event.*, type(event, 'PublicationEvent'),
       CAST(event.event_id AS string), CAST(event.report_id AS string),
       CAST(event.owner_id AS string), CAST(event.operation AS string),
       CAST(event.version_no AS *int), CAST(event.generation_no AS *int64),
       CAST(event.status AS string), CAST(event.requested_by AS string),
       CAST(event.reason AS *string), CAST(event.failure_code AS *string),
       CAST(event.failure_message AS *string), CAST(event.occurred_at AS time.Time),
       tag(event.version_no, 'json:"versionNo,omitempty"'),
       tag(event.generation_no, 'json:"generationNo,omitempty"'),
       tag(event.reason, 'json:"reason,omitempty"'),
       tag(event.failure_code, 'json:"failureCode,omitempty"'),
       tag(event.failure_message, 'json:"failureMessage,omitempty"'),
       set_limit(event, 0)
FROM (${embed:sql/event.sql}) event
WHERE 1=1
ORDER BY event.occurred_at DESC, event.event_id DESC

#package('studio/runtime_generations/store_active_others')

#import('otheractivepredicate','github.com/viant/datly-studio/studio/runtime_generations/otheractivepredicate')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/runtime-generation-store/active-others', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('generation', 'sql/read.sql'))

#define($_ = $ExcludeGeneration<int64>(query/excludeGeneration).Required().WithPredicate(3, 'handler', 'otheractivepredicate.OtherActive'))
#define($_ = $Generations<[]*ActiveGeneration>(output/view))

SELECT generation.*, type(generation, 'ActiveGeneration'),
       CAST(generation.generation_no AS int64),
       CAST(generation.status AS string),
       set_limit(generation, 0)
FROM (${embed:sql/read.sql}) generation
WHERE 1=1

#package('studio/runtime_generations/store_status')

#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/runtime-generation-store/status', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('generation', 'sql/read.sql'))

#define($_ = $Status<string>(query/status).Required().WithPredicate(1, 'equal', 'g', 'status'))
#define($_ = $Generations<[]*StoredGeneration>(output/view))

SELECT generation.*, type(generation, 'StoredGeneration'),
       CAST(generation.generation_no AS int64), CAST(generation.status AS string),
       CAST(generation.report_count AS int),
       CAST(generation.activated_at AS *time.Time),
       CAST(generation.diagnostics_json AS json.RawMessage),
       tag(generation.diagnostics_json, 'sqlx:"diagnostics_json,enc=JSON"'),
       set_limit(generation, 1)
FROM (${embed:sql/read.sql}) generation
WHERE 1=1
ORDER BY generation.generation_no DESC

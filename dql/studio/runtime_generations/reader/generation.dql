#package('studio/runtime_generations/reader')

#import('github.com/viant/scy/auth/jwt')
#import('encoding/json')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/runtime-generations', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.runtime_generations.read', 'Read runtime generations'))
#setting($_ = $sql_dest('runtime_generation', 'sql/read.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.RuntimeRead'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(1, 'equal', 'g', 'status'))
#define($_ = $SourceRevision<string>(query/sourceRevision).Optional().WithPredicate(1, 'equal', 'g', 'source_revision'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('generation'))
#define($_ = $OrderBy<string>(query/orderBy).Optional().QuerySelector('generation'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('generation'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('generation'))
#define($_ = $Generations<[]*RuntimeGeneration>(output/view))
SELECT generation.*, type(generation, 'RuntimeGeneration'),
	   CAST(generation.build_manifest_json AS json.RawMessage),
	   CAST(generation.diagnostics_json AS json.RawMessage),
	   tag(generation.build_manifest_json, 'sqlx:"build_manifest_json,enc=JSON"'),
	   tag(generation.diagnostics_json, 'sqlx:"diagnostics_json,enc=JSON"'),
	   set_limit(generation, 100), selector_fields(generation, true), selector_limit(generation, true), selector_offset(generation, true), allowed_order_by_columns(generation, 'generation_no,status,report_count,requested_at,activated_at,retired_at')
FROM (${embed:sql/read.sql}) generation
WHERE 1=1

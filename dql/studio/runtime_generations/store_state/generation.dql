#package('studio/runtime_generations/store_state')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/runtime-generation-store/state', 'PATCH'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('generation', 'sql/read.sql'))

#define($_ = $Operation<string>(query/operation).Required())
#define($_ = $TargetGeneration<int64>(query/targetGeneration).Required())
#define($_ = $Generations<[]*StoredGeneration>(body/data))

SELECT generation.*, type(generation, 'StoredGeneration'),
       CAST(generation.generation_no AS int64),
       CAST(generation.status AS string),
       CAST(generation.report_count AS *int),
       CAST(generation.activated_at AS *time.Time),
       CAST(generation.retired_at AS *time.Time),
       tag(generation.generation_no, 'sqlx:"generation_no,primaryKey"'),
       lifecycle_type(generation, 'GenerationStateRules'),
       concurrency_token(generation.status)
FROM (${embed:sql/read.sql}) generation

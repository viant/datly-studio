#package('studio/runtime_generations/store_head')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/runtime-generation-store/head', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('head', 'sql/read.sql'))

#define($_ = $Heads<[]*GenerationHead>(output/view))

SELECT head.*, type(head, 'GenerationHead'),
       CAST(head.max_generation AS int64), set_limit(head, 1)
FROM (${embed:sql/read.sql}) head
WHERE 1=1

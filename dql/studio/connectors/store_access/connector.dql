#package('studio/connectors/store_access')

#import('connectoraccess','github.com/viant/datly-studio/studio/connectors/accesspredicate')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/connector-store/access', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('connector', 'sql/read.sql'))

#define($_ = $Name<string>(query/name).Required())
#define($_ = $Subject<string>(query/subject).Required())
#define($_ = $Permission<string>(query/permission).Required().WithPredicate(3, 'handler', 'connectoraccess.ConnectorAccess'))
#define($_ = $Connectors<[]*StoredConnector>(output/view))

SELECT connector.*, type(connector, 'StoredConnector'),
       CAST(connector.name AS string), set_limit(connector, 1)
FROM (${embed:sql/read.sql}) connector
WHERE 1=1

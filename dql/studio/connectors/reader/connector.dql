#package('studio/connectors/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')
#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/connectors.list', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.connectors.list', 'List authorized Datly Studio connectors'))
#setting($_ = $sql_dest('connector', 'sql/connector.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.ConnectorRead'))
#define($_ = $Query<string>(body/query).WithTag('json:"query"').Optional().WithPredicate(0, 'contains', 'c', 'name').WithPredicate(0, 'contains', 'c', 'description').WithPredicate(0, 'contains', 'c', 'driver').WithPredicate(0, 'contains', 'c', 'owner_id'))
#define($_ = $Status<string>(body/status).WithTag('json:"status"').Optional().WithPredicate(1, 'equal', 'c', 'status'))
#define($_ = $OwnerID<string>(body/ownerId).WithTag('json:"ownerId"').Optional().WithPredicate(1, 'equal', 'c', 'owner_id'))
#define($_ = $Driver<string>(body/driver).WithTag('json:"driver"').Optional().WithPredicate(1, 'equal', 'c', 'driver'))
#define($_ = $Fields<[]string>(body/fields).WithTag('json:"fields"').Optional())
#define($_ = $OrderBy<string>(body/orderBy).WithTag('json:"orderBy"').Optional())
#define($_ = $Limit<int>(body/limit).WithTag('json:"limit"').Optional().QuerySelector('connector'))
#define($_ = $Offset<int>(body/offset).WithTag('json:"offset"').Optional().QuerySelector('connector'))
#define($_ = $Items<[]*Connector>(output/view))
#define($_ = $PageLimit<int>(output/body).WithTag('json:"limit"'))
#define($_ = $PageOffset<int>(output/body).WithTag('json:"offset"'))

SELECT connectors.*, type(connectors, 'Connector'),
	   CAST(connectors.name AS string), CAST(connectors.driver AS string),
	   CAST(connectors.dsn_configured AS bool),
	   CAST(connectors.secret_configured AS bool),
	   CAST(connectors.description AS *string), CAST(connectors.owner_id AS string),
	   CAST(connectors.status AS string),
	   CAST(connectors.options_json AS json.RawMessage),
	   CAST(connectors.last_test_status AS *string), CAST(connectors.last_test_error_code AS *string),
	   CAST(connectors.last_tested_at AS *time.Time), CAST(connectors.etag AS int64),
	   CAST(connectors.created_at AS time.Time), CAST(connectors.updated_at AS time.Time),
	   tag(connectors.description, 'json:"description,omitempty"'),
	   tag(connectors.options_json, 'json:"options,omitempty" sqlx:"options_json,enc=JSON"'),
	   tag(connectors.last_test_status, 'json:"lastTestStatus,omitempty"'),
	   tag(connectors.last_test_error_code, 'json:"lastTestErrorCode,omitempty"'),
	   tag(connectors.last_tested_at, 'json:"lastTestedAt,omitempty"'),
       set_limit(connectors, 500),
       selector_limit(connectors, true),
       selector_offset(connectors, true)
FROM (
    ${embed:sql/read.sql}
) connectors
WHERE 1=1
${predicate.Builder().CombineAnd($predicate.FilterGroup(3, "AND")).Build("AND")}
ORDER BY connectors.updated_at DESC, connectors.name ASC

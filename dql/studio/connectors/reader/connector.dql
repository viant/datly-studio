#package('studio/connectors/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/connectors', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.connectors.read', 'Read Datly Studio connectors'))
#setting($_ = $sql_dest('connector', 'sql/connector.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required())
#define($_ = $Name<string>(path/name).Required().WithURI('/{name}').WithPredicate(2, 'equal', 'c', 'name'))
#define($_ = $Query<string>(query/q).Optional().WithPredicate(0, 'contains', 'c', 'name').WithPredicate(0, 'contains', 'c', 'description'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(1, 'equal', 'c', 'status'))
#define($_ = $OwnerID<string>(query/owner).Optional().WithPredicate(1, 'equal', 'c', 'owner_id'))
#define($_ = $Driver<string>(query/driver).Optional().WithPredicate(1, 'equal', 'c', 'driver'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('connector'))
#define($_ = $OrderBy<string>(query/orderBy).Optional().QuerySelector('connector'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('connector'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('connector'))
#define($_ = $Connectors<[]*Connector>(output/view))

SELECT connectors.*, type(connectors, 'Connector'),
	   CAST(connectors.secret_configured AS bool),
	   CAST(connectors.options_json AS json.RawMessage),
	   tag(connectors.options_json, 'sqlx:"options_json,enc=JSON"'),
       set_limit(connectors, 100),
       selector_fields(connectors, true),
       selector_limit(connectors, true),
       selector_offset(connectors, true),
       allowed_order_by_columns(connectors, 'name,status,driver,owner_id,updated_at')
FROM (
    ${embed:sql/read.sql}
) connectors
WHERE 1=1

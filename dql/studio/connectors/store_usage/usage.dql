#package('studio/connectors/store_usage')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/connector-store/usage', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('usage', 'sql/read.sql'))

#define($_ = $Name<string>(query/name).Required())
#define($_ = $Usages<[]*ConnectorUsage>(output/view))

SELECT usage.*, type(usage, 'ConnectorUsage'),
       CAST(usage.used AS int64), set_limit(usage, 1)
FROM (${embed:sql/read.sql}) usage
WHERE 1=1

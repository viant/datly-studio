#package('studio/connectors/store_insert')

#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/connector-store/insert', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('connector', 'sql/read.sql'))

#define($_ = $Connectors<[]*StoredConnector>(body/data))

SELECT connector.*, type(connector, 'StoredConnector'),
       CAST(connector.name AS string), CAST(connector.driver AS string),
       CAST(connector.dsn_template AS *string), CAST(connector.secret_ref AS *string),
       CAST(connector.description AS *string), CAST(connector.owner_id AS string),
       CAST(connector.status AS string), CAST(connector.options_json AS json.RawMessage),
       CAST(connector.etag AS int64), CAST(connector.created_at AS time.Time),
       CAST(connector.updated_at AS time.Time),
       tag(connector.name, 'sqlx:"name,primaryKey"'),
       tag(connector.options_json, 'sqlx:"options_json,enc=JSON"'),
       lifecycle_type(connector, 'ConnectorInsertRules')
FROM (${embed:sql/read.sql}) connector
WHERE 1=1

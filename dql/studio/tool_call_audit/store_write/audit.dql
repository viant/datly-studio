#package('studio/tool_call_audit/store_write')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/tool-call-audit/write', 'POST'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))

#define($_ = $Data<[]*ToolCallAudit>(output/body))

SELECT calls.*, type(calls, 'ToolCallAudit'),
 CAST(calls.id AS int64), tag(calls.id,'sqlx:"id,primaryKey,autoincrement"'),
 CAST(calls.tool_name AS string), CAST(calls.started_at AS time.Time),
 CAST(calls.status AS string), CAST(calls.duration_ms AS *int64),
 CAST(calls.request_body AS []byte), CAST(calls.response_body AS []byte),
 CAST(calls.request_original_bytes AS *int64),
 CAST(calls.request_compression AS string), CAST(calls.response_compression AS string),
 CAST(calls.response_truncated AS bool)
FROM (${embed:sql/read.sql}) calls

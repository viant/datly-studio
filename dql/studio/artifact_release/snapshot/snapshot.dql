#package('studio/artifact_release/snapshot')
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/artifact-release-store/snapshot', 'GET'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('channel', 'sql/root.sql'))
#define($_ = $ScopeId<string>(query/scopeId).Required().WithPredicate(0,'equal','r','scope_id'))
#define($_ = $Name<string>(query/name).Optional().WithPredicate(0,'equal','r','name'))
#define($_ = $ActiveOnly<bool>(query/activeOnly).Optional().WithPredicate(0,'is_not_null','r','active_bundle_hash'))
#define($_ = $Data<[]*ReleaseChannel>(output/view))
SELECT channel.*, set_limit(channel,0), bundle.*, binding.*, operation.*, type(channel,'ReleaseChannel'), type(bundle,'StoredBundle'),type(binding,'BundleBinding'),type(operation,'ReleaseOperation'),CAST(channel.revision AS int64),CAST(operation.expected_revision AS int64),CAST(operation.target_revision AS int64),
       optional(channel.scope_id), optional(channel.tenant_id), optional(channel.account_id), optional(channel.workspace_id), optional(channel.namespace), optional(channel.name), optional(channel.description), optional(channel.policy_refs_json), optional(channel.created_at), optional(channel.created_by), optional(channel.updated_at), optional(channel.updated_by), optional(bundle.scope_id), optional(bundle.tenant_id), optional(bundle.account_id), optional(bundle.workspace_id), optional(bundle.namespace), optional(bundle.bundle_hash), optional(bundle.bundle_json), optional(bundle.created_at), optional(bundle.created_by), optional(bundle.updated_at), optional(bundle.updated_by), optional(binding.scope_id), optional(binding.bundle_hash), optional(binding.bindings_json), optional(binding.bindings_hash), optional(binding.created_at), optional(binding.created_by), optional(binding.updated_at), optional(binding.updated_by), optional(operation.operation_id), optional(operation.scope_id), optional(operation.channel_name), optional(operation.target_bundle_hash), optional(operation.next_channel_json), optional(operation.status), optional(operation.created_at), optional(operation.created_by), optional(operation.updated_at), optional(operation.updated_by)
FROM (${embed:sql/root.sql}) channel
LEFT JOIN (SELECT * FROM artifact_release_bundles) bundle ON bundle.scope_id=channel.scope_id AND bundle.bundle_hash=channel.active_bundle_hash AND 1=1
LEFT JOIN (SELECT * FROM artifact_release_bundle_bindings) binding ON binding.scope_id=channel.scope_id AND binding.bundle_hash=channel.active_bundle_hash AND 1=1
LEFT JOIN (SELECT * FROM artifact_release_operations) operation ON operation.scope_id=channel.scope_id AND operation.operation_id=channel.pending_operation_id AND 1=1
WHERE 1=1

#package('studio/artifact_release/create_channel')
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/artifact-release-store/create_channel', 'POST'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('records','sql/read.sql'))
#define($_ = $ScopeId<string>(query/scopeId).Required().WithTag('json:"-" internal:"true"'))
#define($_ = $Actor<string>(query/actor).Required().WithTag('json:"-" internal:"true"'))
#define($_ = $Records<[]*NewChannel>(body/data).Cardinality('Many'))
#define($_ = $Data<[]*NewChannel>(output/body))
SELECT records.*,type(records,'NewChannel'),lifecycle_type(records,'Rules'),CAST(records.revision AS int64)
FROM (${embed:sql/read.sql}) records
WHERE 1=1

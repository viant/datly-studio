#package('studio/report_skill_roots/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports/{reportId}/versions/{versionNo}/skills', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_skill_roots.read', 'Read report skill roots'))
#setting($_ = $sql_dest('skill_root', 'sql/read.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(path/reportId).Required().WithPredicate(2, 'equal', 's', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.ReportSkillRead'))
#define($_ = $VersionNo<int>(path/versionNo).Required().WithPredicate(2, 'equal', 's', 'version_no'))
#define($_ = $FolderId<string>(query/folderId).Optional().WithPredicate(1, 'equal', 's', 'folder_id'))
#define($_ = $Skills<[]*ReportSkillRoot>(output/view))
SELECT skill_root.*, type(skill_root, 'ReportSkillRoot') FROM (${embed:sql/read.sql}) skill_root
WHERE 1=1

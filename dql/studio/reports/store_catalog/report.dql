#package('studio/reports/store_catalog')

#import('catalogpredicate','github.com/viant/datly-studio/studio/reports/catalogpredicate')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/report-store/catalog', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('report', 'sql/read.sql'))

#define($_ = $Id<string>(query/id).Optional().WithPredicate(2, 'equal', 'r', 'id'))
#define($_ = $Query<string>(query/q).Optional().WithPredicate(0, 'contains', 'r', 'namespace').WithPredicate(0, 'contains', 'r', 'slug').WithPredicate(0, 'contains', 'r', 'title').WithPredicate(0, 'contains', 'r', 'description'))
#define($_ = $Namespace<string>(query/namespace).Optional().WithPredicate(1, 'equal', 'r', 'namespace'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(1, 'equal', 'r', 'status'))
#define($_ = $OwnerId<string>(query/ownerId).Optional().WithPredicate(1, 'equal', 'r', 'owner_id'))
#define($_ = $ConnectorName<string>(query/connector).Optional().WithPredicate(1, 'equal', 'r', 'default_connector_name'))
#define($_ = $Subject<string>(query/subject).Required())
#define($_ = $Scoped<bool>(query/scoped).Required().WithPredicate(3, 'handler', 'catalogpredicate.ReportCatalogRead'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('report'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('report'))
#define($_ = $Reports<[]*StoredReport>(output/view))

SELECT report.*, type(report, 'StoredReport'),
       CAST(report.id AS string), CAST(report.namespace AS string),
       CAST(report.slug AS string), CAST(report.title AS string),
       CAST(report.description AS *string), CAST(report.owner_id AS string),
       CAST(report.status AS string), CAST(report.default_connector_name AS string),
       CAST(report.component_scope AS string), CAST(report.component_name AS string),
       CAST(report.current_draft_version AS *int), CAST(report.etag AS int64),
       CAST(report.created_at AS time.Time), CAST(report.updated_at AS time.Time),
       set_limit(report, 500), selector_limit(report, true),
       selector_offset(report, true),
       allowed_order_by_columns(report, 'updated_at,id')
FROM (${embed:sql/read.sql}) report
WHERE 1=1
ORDER BY report.updated_at DESC, report.id ASC

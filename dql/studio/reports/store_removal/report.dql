#package('studio/reports/store_removal')
#import('encoding/json')
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/reports/store-removal', 'PATCH'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('report','sql/read.sql'))
#define($_ = $ReportId<string>(query/reportId).Required())
#define($_ = $Actor<string>(query/actor).Required())
#define($_ = $NamespaceId<string>(query/namespaceId).Required())
#define($_ = $TargetVersion<int>(query/targetVersion))
#define($_ = $Publications<[]*PublicationReference>(view/Publications).WithConnector('studio').WithLimit(0) /*
SELECT p.report_id, p.active_version_no, p.desired_version_no FROM component_publications p WHERE p.report_id = $ReportId
*/)
#define($_ = $BundleBindings<[]*BundleBinding>(view/BundleBindings).WithConnector('studio').WithLimit(0).WithColumnType('bindings_json','json.RawMessage') /*
SELECT b.scope_id,b.bundle_hash,b.bindings_json FROM artifact_release_bundle_bindings b
*/)
#define($_ = $WarmupSnapshot<[]*ExistingWarmup>(view/WarmupSnapshot).WithConnector('studio').WithLimit(0) /*
SELECT w.run_id,w.report_id,w.version_no,w.status FROM component_warmup_runs w
WHERE w.report_id = $ReportId
  AND ($TargetVersion = 0 OR w.version_no = $TargetVersion)
*/)
#define($_ = $Reports<[]*RemovalReport>(body/data))

SELECT report.*, version.*, warmup.*, deletion.*,
       type(report,'RemovalReport'), set_limit(report,1), set_limit(version,0), set_limit(warmup,0), type(version,'RemovalVersion'), type(warmup,'RemovalWarmup'),
       CAST(report.id AS string), CAST(report.namespace_id AS string), CAST(report.owner_id AS string),
       CAST(report.etag AS *int64), CAST(report.current_draft_version AS *int), CAST(report.updated_at AS *time.Time),
       CAST(report.should_delete AS bool),
       CAST(version.report_id AS string), CAST(version.namespace_id AS string), CAST(version.version_no AS int),
       CAST(version.source_revision AS *int64), CAST(version.should_delete AS bool),
       CAST(warmup.run_id AS string), CAST(warmup.report_id AS string), CAST(warmup.version_no AS int),
       CAST(warmup.status AS string), CAST(warmup.should_delete AS bool),
       tag(report.id,'sqlx:"id,primaryKey"'),
       tag(version.report_id,'sqlx:"report_id,primaryKey"'), tag(version.version_no,'sqlx:"version_no,primaryKey"'),
       tag(warmup.run_id,'sqlx:"run_id,primaryKey"'),
       type(deletion,'RemovalReceipt'),
       CAST(deletion.component_id AS string), CAST(deletion.namespace_id AS string), CAST(deletion.owner_id AS string),
       CAST(deletion.deleted_at AS time.Time), CAST(deletion.deleted_by AS string),
       tag(deletion.component_id,'sqlx:"component_id,primaryKey"'),
       lifecycle_type(report,'RemovalRules'), lifecycle_type(version,'VersionRules'),
       lifecycle_type(warmup,'WarmupRules'), lifecycle_type(deletion,'ReceiptRules'),
       concurrency_token(report.etag), concurrency_token(version.source_revision), concurrency_token(warmup.status),
       delete_marker(report.should_delete), delete_marker(version.should_delete), delete_marker(warmup.should_delete)
FROM (${embed:sql/read.sql}) report
LEFT JOIN (${embed:sql/versions.sql}) version ON version.report_id = report.id AND version.namespace_id = report.namespace_id
LEFT JOIN (${embed:sql/warmups.sql}) warmup ON warmup.report_id = version.report_id AND warmup.version_no = version.version_no
LEFT JOIN (${embed:sql/deletion.sql}) deletion ON deletion.component_id = report.id
WHERE 1=1

#package('studio/reports/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.reports.read', 'Read Datly Studio reports'))
#setting($_ = $sql_dest('report', 'sql/report.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required())
#define($_ = $Id<string>(path/id).Required().WithURI('/{id}').WithPredicate(2, 'equal', 'r', 'id'))
#define($_ = $Query<string>(query/q).Optional().WithPredicate(0, 'contains', 'r', 'slug').WithPredicate(0, 'contains', 'r', 'title').WithPredicate(0, 'contains', 'r', 'description'))
#define($_ = $Namespace<string>(query/namespace).Optional().WithPredicate(1, 'equal', 'r', 'namespace'))
#define($_ = $Status<string>(query/status).Optional().WithPredicate(1, 'equal', 'r', 'status'))
#define($_ = $OwnerId<string>(query/owner).Optional().WithPredicate(1, 'equal', 'r', 'owner_id'))
#define($_ = $ConnectorName<string>(query/connector).Optional().WithPredicate(1, 'equal', 'r', 'default_connector_name'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('report'))
#define($_ = $OrderBy<string>(query/orderBy).Optional().QuerySelector('report'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('report'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('report'))
#define($_ = $Reports<[]*Report>(output/view))

SELECT reports.*, type(reports, 'Report'), CAST(reports.namespace AS string),
       set_limit(reports, 100),
       selector_fields(reports, true),
       selector_limit(reports, true),
       selector_offset(reports, true),
       allowed_order_by_columns(reports, 'namespace,slug,title,status,owner_id,default_connector_name,current_draft_version,updated_at')
FROM (
    ${embed:sql/read.sql}
) reports
WHERE 1=1

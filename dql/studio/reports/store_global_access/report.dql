#package('studio/reports/store_global_access')

#import('globalpredicate','github.com/viant/datly-studio/studio/reports/globalpredicate')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/report-store/global-access', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('report', 'sql/read.sql'))

#define($_ = $Subject<string>(query/subject).Required().WithPredicate(3, 'handler', 'globalpredicate.GlobalPublish'))
#define($_ = $Reports<[]*StoredReport>(output/view))

SELECT report.*, type(report, 'StoredReport'),
       CAST(report.id AS string), set_limit(report, 1)
FROM (${embed:sql/read.sql}) report
WHERE 1=1

#package('studio/reports/get')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('catalogpredicate','github.com/viant/datly-studio/studio/reports/catalogpredicate')

#setting($_ = $input_type('ReportGetInput'))
#setting($_ = $output_type('ReportGetOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/reports.get', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.reports.get', 'Read one authorized Datly Studio component'))
#setting($_ = $sql_dest('report', 'sql/report.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'catalogpredicate.ReportCatalogRead'))
#define($_ = $Id<string>(body/id).WithTag('json:"id"').Required().WithPredicate(2, 'equal', 'r', 'id'))
#define($_ = $Item<*Report>(output/view).WithTag('json:"-"'))
#define($_ = $ResponseId<string>(output/body).WithTag('json:"id"'))
#define($_ = $Namespace<string>(output/body).WithTag('json:"namespace"'))
#define($_ = $Slug<string>(output/body).WithTag('json:"slug"'))
#define($_ = $Title<string>(output/body).WithTag('json:"title"'))
#define($_ = $Description<string>(output/body).WithTag('json:"description,omitempty"'))
#define($_ = $OwnerId<string>(output/body).WithTag('json:"ownerId"'))
#define($_ = $OwnerPackage<string>(output/body).WithTag('json:"ownerPackage"'))
#define($_ = $Status<string>(output/body).WithTag('json:"status"'))
#define($_ = $DefaultConnectorName<string>(output/body).WithTag('json:"defaultConnectorName"'))
#define($_ = $ComponentScope<string>(output/body).WithTag('json:"componentScope"'))
#define($_ = $ComponentName<string>(output/body).WithTag('json:"componentName"'))
#define($_ = $CurrentDraftVersion<*int>(output/body).WithTag('json:"currentDraftVersion,omitempty"'))
#define($_ = $Etag<int64>(output/body).WithTag('json:"etag"'))
#define($_ = $CreatedAt<time.Time>(output/body).WithTag('json:"createdAt"'))
#define($_ = $UpdatedAt<time.Time>(output/body).WithTag('json:"updatedAt"'))

SELECT report.*, type(report, 'Report'),
       CAST(report.id AS string), CAST(report.namespace AS string),
       CAST(report.slug AS string), CAST(report.title AS string),
       CAST(report.description AS *string), CAST(report.owner_id AS string),
       CAST(report.owner_package AS string), CAST(report.status AS string),
       CAST(report.default_connector_name AS string),
       CAST(report.component_scope AS string), CAST(report.component_name AS string),
       CAST(report.current_draft_version AS *int), CAST(report.etag AS int64),
       CAST(report.created_at AS time.Time), CAST(report.updated_at AS time.Time),
       tag(report.description, 'json:"description,omitempty"'),
       tag(report.current_draft_version, 'json:"currentDraftVersion,omitempty"'),
       set_limit(report, 1)
FROM (${embed:sql/read.sql}) report
WHERE 1=1

#package('studio/report_versions/store_head')
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/report-version-store/head', 'GET'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('head', 'sql/read.sql'))
#define($_ = $ReportId<string>(query/reportId).Required())
#define($_ = $NamespaceId<string>(query/namespaceId).Required())
#define($_ = $Heads<[]*VersionHead>(output/view))
SELECT head.*, row_lock(head,'components c','c.id'), type(head, 'VersionHead'), CAST(head.id AS string), CAST(head.namespace_id AS string),
 CAST(head.last_version_no AS int), CAST(head.max_version_no AS int), set_limit(head, 1)
FROM (${embed:sql/read.sql}) head

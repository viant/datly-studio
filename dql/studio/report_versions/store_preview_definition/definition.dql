#package('studio/report_versions/store_preview_definition')

#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/preview-definition', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('definition', 'sql/read.sql'))

#define($_ = $ReportId<string>(query/reportId).Required())
#define($_ = $VersionNo<int>(query/versionNo).Required())
#define($_ = $Definitions<[]*PreviewDefinition>(output/view))

SELECT definition.*, type(definition, 'PreviewDefinition'),
       CAST(definition.report_id AS string),
       CAST(definition.version_no AS int),
       CAST(definition.component_scope AS string),
       CAST(definition.component_name AS string),
       CAST(definition.default_connector_name AS string),
       CAST(definition.driver AS string),
       CAST(definition.secret_ref AS string),
       CAST(definition.options_json AS json.RawMessage),
       tag(definition.options_json, 'sqlx:"options_json,enc=JSON"'),
       CAST(definition.source_revision AS int64),
       CAST(definition.spec_hash AS string),
       CAST(definition.generated_dql AS string),
       CAST(definition.authored_dql AS string),
       set_limit(definition, 1)
FROM (${embed:sql/read.sql}) definition
WHERE 1=1

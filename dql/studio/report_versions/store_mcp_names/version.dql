#package('studio/report_versions/store_mcp_names')

#import('mcpscope','github.com/viant/datly-studio/studio/report_versions/mcpnamepredicate')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/report-version-store/mcp-names', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('version', 'sql/read.sql'))

#define($_ = $ReportId<string>(query/reportId).Required().WithPredicate(3, 'handler', 'mcpscope.OtherReportCandidate'))
#define($_ = $Versions<[]*NameSource>(output/view))

SELECT version.*, type(version, 'NameSource'),
       CAST(version.report_id AS string), CAST(version.version_no AS int),
       CAST(version.generated_dql AS *string), CAST(version.authored_dql AS *string),
       set_limit(version, 0)
FROM (${embed:sql/read.sql}) version
WHERE 1=1

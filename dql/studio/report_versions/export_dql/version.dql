#package('studio/report_versions/export_dql')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('VersionExportInput'))
#setting($_ = $output_type('VersionExportOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/versions.export_dql', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.versions.export_dql', 'Export authorized Datly Studio DQL source'))
#setting($_ = $sql_dest('version', 'sql/version.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.ReportVersionRead'))
#define($_ = $ReportId<string>(body/reportId).WithTag('json:"reportId"').Required().WithPredicate(2, 'equal', 'v', 'report_id'))
#define($_ = $VersionNo<int>(body/versionNo).WithTag('json:"versionNo"').Required().WithPredicate(2, 'equal', 'v', 'version_no'))
#define($_ = $Item<*VersionSource>(output/view).WithTag('json:"-"'))
#define($_ = $Dql<string>(output/body).WithTag('json:"dql"'))
#define($_ = $Complete<bool>(output/body).WithTag('json:"complete"'))

SELECT version.*, type(version, 'VersionSource'),
       CAST(version.report_id AS string), CAST(version.version_no AS int),
       CAST(version.dql AS string), set_limit(version, 1)
FROM (${embed:sql/version.sql}) version
WHERE 1=1

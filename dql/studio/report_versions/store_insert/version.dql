#package('studio/report_versions/store_insert')

#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/report-version-store/insert', 'PATCH'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('allocation', 'sql/read.sql'))

#define($_ = $Allocations<[]*VersionAllocation>(body/data))

SELECT allocation.*, type(allocation, 'VersionAllocation'),
       CAST(allocation.id AS string), CAST(allocation.namespace_id AS string),
       CAST(allocation.last_version_no AS *int),
       tag(allocation.id, 'sqlx:"id,primaryKey"'),
       concurrency_token(allocation.last_version_no), lifecycle_type(allocation, 'AllocationRules'),
       draft.*, type(draft, 'StoredVersion'),
       CAST(draft.report_id AS string), CAST(draft.resource_check_enabled AS bool), CAST(draft.namespace_id AS string), CAST(draft.version_no AS int),
       CAST(draft.state AS string), CAST(draft.authoring_mode AS string),
       CAST(draft.authored_sql AS *string), CAST(draft.authored_dql AS *string),
       CAST(draft.component_spec_json AS json.RawMessage),
       CAST(draft.spec_format_version AS string), CAST(draft.spec_hash AS string),
       CAST(draft.generated_dql AS *string),
       CAST(draft.type_manifest_json AS json.RawMessage),
       CAST(draft.compile_status AS string), CAST(draft.datly_version AS string),
       CAST(draft.compiler_version AS string), CAST(draft.source_revision AS int64),
       CAST(draft.notes AS *string), CAST(draft.created_by AS string),
       CAST(draft.created_at AS time.Time),
       tag(draft.report_id, 'sqlx:"report_id,primaryKey"'),
       tag(draft.version_no, 'sqlx:"version_no,primaryKey"'),
       tag(draft.component_spec_json, 'sqlx:"component_spec_json,enc=JSON"'),
       tag(draft.type_manifest_json, 'sqlx:"type_manifest_json,enc=JSON"'),
       lifecycle_type(draft, 'VersionInsertRules')
FROM (${embed:sql/read.sql}) allocation
LEFT JOIN (${embed:sql/versions.sql}) draft
 ON draft.report_id = allocation.id AND draft.namespace_id = allocation.namespace_id

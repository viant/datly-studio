#package('studio/bff_sessions/lease_write')

#import('leasepredicate','github.com/viant/datly-studio/studio/bff_sessions/leasepredicate')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/bff-session-lease/write', 'PATCH'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))

#define($_ = $Operation<string>(query/operation).Required())
#define($_ = $LeaseOwner<string>(query/leaseOwner).Required())
#define($_ = $NowUnix<int64>(query/nowUnix).Required())
#define($_ = $Guard<bool>(query/guard).Required().WithPredicate(7,'handler','leasepredicate.Condition'))
#define($_ = $Sessions<[]*LeaseSession>(body/data))
#define($_ = $Data<[]*LeaseSession>(output/body))

SELECT session.*, type(session,'LeaseSession'), lifecycle_type(session,'LeaseRules'), mutation_predicate(session,7),
       CAST(session.session_id_hash AS string), CAST(session.refresh_lease_owner AS string),
       CAST(session.refresh_lease_until_unix AS int64), CAST(session.payload_ciphertext AS []byte)
FROM (SELECT session_id_hash,refresh_lease_owner,refresh_lease_until_unix,payload_ciphertext FROM bff_sessions) session

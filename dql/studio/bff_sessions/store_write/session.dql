#package('studio/bff_sessions/store_write')

#import('github.com/viant/xdatly/response')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/bff-session-store', 'PATCH'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('session', 'sql/patch.sql'))

#define($_ = $Sessions<[]*StoredSession>(body/data))
#define($_ = $Status<response.Status>(output/status).Embed())
#define($_ = $Violations<?>(transient/status).Output())

SELECT session.*, type(session, 'StoredSession'),
       tag(session.session_id_hash, 'sqlx:"session_id_hash,primaryKey" validate:"required"'),
       CAST(session.session_id_hash AS string),
       CAST(session.subject_id AS string),
       CAST(session.payload_ciphertext AS []byte),
       CAST(session.expires_at_unix AS int64),
       CAST(session.should_delete AS bool),
       delete_marker(session.should_delete)
FROM (${embed:sql/patch.sql}) session
WHERE 1=1

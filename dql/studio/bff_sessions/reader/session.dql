#package('studio/bff_sessions/reader')

#import('github.com/viant/scy/auth/jwt')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sessions', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('session', 'sql/read.sql'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.SessionRead'))
#define($_ = $Sessions<[]*SessionMetadata>(output/view))
SELECT session.*, type(session, 'SessionMetadata'),
       set_limit(session, 100)
FROM (${embed:sql/read.sql}) session
WHERE 1=1

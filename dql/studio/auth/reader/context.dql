#package('studio/auth/reader')

#import('github.com/viant/scy/auth/jwt')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/auth/context', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('context', 'sql/context.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*AuthContext>(output/view))

SELECT auth.*, type(auth, 'AuthContext'),
       CAST(auth.subject AS string),
       CAST(auth.username AS string),
       CAST(auth.email AS string),
       CAST(auth.user_id AS int),
       cardinality(auth, 'One'), set_limit(auth, 1)
FROM (
    ${embed:sql/context.sql}
) auth

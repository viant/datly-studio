#package('studio/report_warmup_runs/store_write')

#import('encoding/json')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/report-warmup-run-store/write', 'PATCH'))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('warmup_run', 'sql/read.sql'))

#define($_ = $Runs<[]*StoredWarmupRun>(body/data))

SELECT warmup_run.*, type(warmup_run, 'StoredWarmupRun'),
       CAST(warmup_run.run_id AS string), CAST(warmup_run.report_id AS string),
       CAST(warmup_run.version_no AS int), CAST(warmup_run.source_revision AS int64),
       CAST(warmup_run.spec_hash AS string), CAST(warmup_run.plan_key AS string),
       CAST(warmup_run.active_key AS *string), CAST(warmup_run.status AS string),
       CAST(warmup_run.requested_by AS string),
       CAST(warmup_run.cache_name AS *string), CAST(warmup_run.cache_provider AS *string),
       CAST(warmup_run.connector_name AS *string), CAST(warmup_run.index_column AS *string),
       CAST(warmup_run.planned_cases AS int), CAST(warmup_run.completed_cases AS int),
       CAST(warmup_run.max_cases AS *int), CAST(warmup_run.row_limit AS *int),
       CAST(warmup_run.entries AS int), CAST(warmup_run.duration_ns AS int64),
       CAST(warmup_run.diagnostics_json AS *json.RawMessage),
       CAST(warmup_run.target_json AS json.RawMessage),
       CAST(warmup_run.requested_at AS time.Time),
       CAST(warmup_run.created_at AS *time.Time), CAST(warmup_run.created_by AS *string),
       CAST(warmup_run.updated_at AS *time.Time),
       CAST(warmup_run.updated_by AS *string),
       CAST(warmup_run.started_at AS *time.Time), CAST(warmup_run.completed_at AS *time.Time),
       tag(warmup_run.run_id, 'sqlx:"run_id,primaryKey"'),
       lifecycle_type(warmup_run, 'WarmupRunRules'),
       concurrency_token(warmup_run.updated_at),
       set_limit(warmup_run, 0)
FROM (${embed:sql/read.sql}) warmup_run
WHERE 1=1

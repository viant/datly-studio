#package('studio/report_warmup_runs/get')

#import('github.com/viant/scy/auth/jwt')
#import('encoding/json')
#import('sdk','github.com/viant/datly-studio/sdk')
#import('studioauth','github.com/viant/datly-studio/studio/auth/reader')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('WarmupGetInput'))
#setting($_ = $output_type('WarmupGetOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/sdk/versions.warmup_get', 'POST'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.sdk.versions.warmup_get', 'Read one authorized Datly Studio cache warmup run'))
#setting($_ = $sql_dest('warmup_run', 'sql/warmup_run.sql'))

#define($_ = $NamespaceId<*string>(header/X-Studio-Namespace).Optional().WithTag('json:"namespaceId,omitempty"'))
#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $Auth<*studioauth.Output>(component/GET:/v1/studio/auth/context).Required().WithPredicate(3, 'handler', 'studioauthorization.WarmupRead'))
#define($_ = $ReportId<string>(body/reportId).WithTag('json:"reportId"').Required().WithPredicate(2, 'equal', 'w', 'report_id'))
#define($_ = $RunId<string>(body/runId).WithTag('json:"runId"').Required().WithPredicate(2, 'equal', 'w', 'run_id'))
#define($_ = $Item<*WarmupRow>(output/view).WithTag('json:"-"'))
#define($_ = $Response<*sdk.WarmupRun>(output/body).WithTag('json:"-"'))

SELECT warmup_run.*, type(warmup_run, 'WarmupRow'),
       CAST(warmup_run.run_id AS string), CAST(warmup_run.report_id AS string),
       CAST(warmup_run.version_no AS int), CAST(warmup_run.source_revision AS int64),
       CAST(warmup_run.spec_hash AS string), CAST(warmup_run.plan_key AS string),
       CAST(warmup_run.status AS string), CAST(warmup_run.requested_by AS string),
       CAST(warmup_run.requested_at AS time.Time),
       CAST(warmup_run.created_at AS *time.Time), CAST(warmup_run.created_by AS *string),
       CAST(warmup_run.updated_at AS *time.Time), CAST(warmup_run.updated_by AS *string),
       CAST(warmup_run.started_at AS *time.Time), CAST(warmup_run.completed_at AS *time.Time),
       CAST(warmup_run.planned_cases AS int), CAST(warmup_run.completed_cases AS int),
       CAST(warmup_run.max_cases AS *int), CAST(warmup_run.row_limit AS *int),
       CAST(warmup_run.entries AS int), CAST(warmup_run.duration_ns AS int64),
       CAST(warmup_run.target_json AS json.RawMessage), CAST(warmup_run.diagnostics_json AS json.RawMessage),
       tag(warmup_run.target_json, 'sqlx:"target_json,enc=JSON"'),
       tag(warmup_run.diagnostics_json, 'sqlx:"diagnostics_json,enc=JSON"'),
       set_limit(warmup_run, 1)
FROM (${embed:sql/warmup_run.sql}) warmup_run
WHERE 1=1

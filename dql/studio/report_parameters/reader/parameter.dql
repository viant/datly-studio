#package('studio/report_parameters/reader')

#import('github.com/viant/scy/auth/jwt')
#import('encoding/json')
#import('studioauthorization','github.com/viant/datly-studio/studio/authorization')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/v1/studio/reports/{reportId}/versions/{versionNo}/parameters', 'GET'))
#setting($_ = $connector('studio'))
#setting($_ = $mcp('studio.report_parameters.read', 'Read report parameters and predicates'))
#setting($_ = $sql_dest('report_parameter', 'sql/read.sql'))

#define($_ = $Jwt<string,*jwt.Claims>(header/Authorization).Required().WithCodec(JwtClaim).WithStatusCode(401))
#define($_ = $ReportId<string>(path/reportId).Required().WithPredicate(2, 'equal', 'p', 'report_id').WithPredicate(3, 'handler', 'studioauthorization.ReportParameterRead'))
#define($_ = $VersionNo<int>(path/versionNo).Required().WithPredicate(2, 'equal', 'p', 'version_no'))
#define($_ = $SourceKind<string>(query/sourceKind).Optional().WithPredicate(1, 'equal', 'p', 'source_kind'))
#define($_ = $Required<bool>(query/required).Optional().WithPredicate(1, 'equal', 'p', 'required'))
#define($_ = $EmitOutput<bool>(query/emitOutput).Optional().WithPredicate(1, 'equal', 'p', 'emit_output'))
#define($_ = $Fields<[]string>(query/fields).Optional().QuerySelector('parameter'))
#define($_ = $OrderBy<string>(query/orderBy).Optional().QuerySelector('parameter'))
#define($_ = $Limit<int>(query/limit).Optional().QuerySelector('parameter'))
#define($_ = $Offset<int>(query/offset).Optional().QuerySelector('parameter'))
#define($_ = $Parameters<[]*ReportParameter>(output/view))

SELECT parameters.*, predicates.*, type(parameters, 'ReportParameter'), type(predicates, 'ReportPredicate'),
	   CAST(parameters.query_selector_json AS json.RawMessage),
	   CAST(parameters.codec_json AS json.RawMessage),
	   CAST(parameters.activation_json AS json.RawMessage),
	   CAST(parameters.metadata_json AS json.RawMessage),
	   CAST(predicates.args_json AS json.RawMessage),
	   tag(parameters.query_selector_json, 'sqlx:"query_selector_json,enc=JSON"'),
	   tag(parameters.codec_json, 'sqlx:"codec_json,enc=JSON"'),
	   tag(parameters.activation_json, 'sqlx:"activation_json,enc=JSON"'),
	   tag(parameters.metadata_json, 'sqlx:"metadata_json,enc=JSON"'),
	   tag(predicates.args_json, 'sqlx:"args_json,enc=JSON"')
FROM (
    ${embed:sql/read.sql}
) parameters
LEFT JOIN (
    ${embed:sql/predicates.sql}
) predicates
  ON predicates.report_id = parameters.report_id
 AND predicates.version_no = parameters.version_no
 AND predicates.parameter_id = parameters.parameter_id
WHERE 1=1

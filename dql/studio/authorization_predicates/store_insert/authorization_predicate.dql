#package('studio/authorization_predicates/store_insert')

#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/_studio/authorization-predicate-store/insert', 'POST'))
#setting($_ = $internal(true))
#setting($_ = $connector('studio'))
#setting($_ = $sql_dest('authorization_predicate', 'sql/read.sql'))

#define($_ = $AuthorizationPredicates<[]*StoredAuthorizationPredicate>(body/data))

SELECT predicate.*, type(predicate, 'StoredAuthorizationPredicate'),
       CAST(predicate.name AS string), CAST(predicate.title AS string),
       CAST(predicate.description AS *string),
       CAST(predicate.package_path AS string), CAST(predicate.type_name AS string),
       CAST(predicate.sql_scope_json AS *string),
       CAST(predicate.owner_id AS string), CAST(predicate.status AS string),
       CAST(predicate.etag AS int64), CAST(predicate.created_at AS time.Time),
       CAST(predicate.updated_at AS time.Time),
       tag(predicate.name, 'sqlx:"name,primaryKey"'),
       lifecycle_type(predicate, 'PredicateInsertRules')
FROM (${embed:sql/read.sql}) predicate
